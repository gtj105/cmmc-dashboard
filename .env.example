# ─────────────────────────────────────────────────────────────────
# CMMC Dashboard — Environment Configuration
# ─────────────────────────────────────────────────────────────────
# SETUP: Run ./scripts/setup-secrets.sh to generate secrets automatically.
# That script creates ./secrets/ files for Docker secrets AND populates this .env.
#
# The actual secret values live in:
#   ./secrets/postgres_password.txt   (mounted as Docker secret)
#   ./secrets/nextauth_secret.txt     (mounted as Docker secret)
#
# This .env file is used by docker-compose for variable substitution only.
# ─────────────────────────────────────────────────────────────────

# Database password — must match ./secrets/postgres_password.txt
# Used in DATABASE_URL for the app service
POSTGRES_PASSWORD=change-me

# Public URL where the dashboard is accessible
NEXTAUTH_URL=http://localhost

# Display name shown in the UI header
ORG_NAME=My Organization

# Append ?sslmode=require for external/managed databases (RDS, etc.)
DATABASE_URL=postgres://user:password@localhost:5432/cmmc

# Backup schedule (cron syntax, default: daily at 2 AM)
# BACKUP_SCHEDULE=0 2 * * *
